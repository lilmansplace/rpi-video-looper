[Unit]
Description=rpi-video-looper
# Started by rpi-video-looper.timer shortly after boot, not during it: on a Pi Zero W,
# starting the player in the middle of boot hung the whole Pi (tested on hardware),
# while starting it once boot settles works every time.
After=local-fs.target systemd-udevd.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=looper
Group=looper
SupplementaryGroups=video render audio input
WorkingDirectory=/opt/rpi-video-looper
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m looper
RuntimeDirectory=looper
StateDirectory=looper

# Self-healing: restart if the process hangs (no watchdog ping) or crashes.
WatchdogSec=60
Restart=always
RestartSec=2
TimeoutStartSec=60

# No priority boost: on a single-core Zero a boosted player can starve Wi-Fi and SSH
# (that's how the first hardware test locked up). Normal priority is plenty when
# the video is hardware-decoded.
# Hard ceiling so a runaway can never take the whole 512 MB down with it.
MemoryHigh=300M
MemoryMax=380M

# No [Install] section: enable rpi-video-looper.timer instead.
