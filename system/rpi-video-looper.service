[Unit]
Description=rpi-video-looper
# Started by rpi-video-looper.timer shortly after boot, not during it: on a Pi Zero W,
# starting the player in the middle of boot hung the whole Pi (tested on hardware),
# while starting it once boot settles works every time.
After=local-fs.target systemd-udevd.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=looper
Group=looper
SupplementaryGroups=video render audio input
WorkingDirectory=/opt/rpi-video-looper
# .pyc are precompiled at install time (see install.sh); let Python use them so every
# boot doesn't re-byte-compile the whole package on a single-core Pi.
Environment=PYTHONUNBUFFERED=1
# Pin GStreamer's plugin registry to a prebuilt file (built by install.sh, or by the
# ExecStartPre below if it is ever missing) so cold boot skips the full plugin scan. That
# scan cost seconds AND raced the first pipeline on a Zero (intermittent "no element
# v4l2h264dec"). UPDATE=no means a GStreamer package upgrade needs a re-run of install.sh.
Environment=GST_REGISTRY=/var/lib/looper/gst-registry.bin
Environment=GST_REGISTRY_UPDATE=no
# Safety net: build the registry once if it is missing (this boot pays the scan; later
# boots take the fast UPDATE=no path). Uses python3-gi, already a dependency.
ExecStartPre=/bin/sh -c 'test -s "$GST_REGISTRY" || GST_REGISTRY_UPDATE=yes python3 -c "import gi; gi.require_version(\"Gst\", \"1.0\"); from gi.repository import Gst; Gst.init(None)" >/dev/null 2>&1 || true'
ExecStart=/usr/bin/python3 -m looper
RuntimeDirectory=looper
StateDirectory=looper

# Self-healing: restart if the process hangs (no watchdog ping) or crashes.
WatchdogSec=60
Restart=always
RestartSec=2
TimeoutStartSec=60

# No priority boost: on a single-core Zero a boosted player can starve Wi-Fi and SSH
# (that's how the first hardware test locked up). Normal priority is plenty when
# the video is hardware-decoded.
# Hard ceiling so a runaway can never take the whole 512 MB down with it.
MemoryHigh=300M
MemoryMax=380M

# No [Install] section: enable rpi-video-looper.timer instead.
