[Unit]
Description=rpi-video-looper network setup (Wi-Fi from looper.toml, setup hotspot)
Wants=NetworkManager.service
After=NetworkManager.service local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m looper.netsetup
WorkingDirectory=/opt/rpi-video-looper
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=looper-net
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
# Never compete with video playback
Nice=10
CPUWeight=50
MemoryMax=80M

[Install]
WantedBy=multi-user.target
